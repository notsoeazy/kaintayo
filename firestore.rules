rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone can read places; only authenticated users can create
    match /places/{placeId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'communityPriceTier', 'totalVotes']);
      allow delete: if false;

      // Photo gallery for the place
      match /photos/{photoId} {
        allow read: if true;
        allow create: if request.auth != null;
      }

      // Community price survey votes
      match /priceVotes/{userId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Users can read/write their own profile and subcollections
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}