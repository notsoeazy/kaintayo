# Firebase Web SDK Config
# Get these from your Firebase project settings → General → Your apps → Web app
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google OAuth (for Google Sign-In via expo-auth-session)
# Get from Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Google Maps SDK (Android)
# Get from Google Cloud Console → APIs & Services → Credentials → API key (restrict to Maps SDK for Android)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
